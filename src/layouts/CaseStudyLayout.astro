---
import BaseLayout from "./BaseLayout.astro";
import MediaBlock from "../components/MediaBlock.astro";
import ProjectOverview from "../components/ProjectOverview.astro";
import type { PublicProfile, ProjectRecord } from "../lib/types";

interface Props { profile: PublicProfile; project: ProjectRecord; }
const { profile, project } = Astro.props;
const categoryLabels = { "client-system": "Client system", "mobile-application": "Android application", "research-project": "Learning project" };
const leadMedia = project.slug === "mileage-tracker" ? project.media.find((slot) => slot.id === "trip-capture") : undefined;
const remainingMedia = project.media.filter((slot) => slot !== leadMedia);
const publishedMedia = remainingMedia.filter((slot) => slot.availability === "published");
const pendingMedia = remainingMedia.filter((slot) => slot.availability !== "published");
const mediaHeading = project.slug === "john-howard" && !publishedMedia.length ? "Planned recordings" : "Application recordings";
const hasOverview = ["john-howard", "mileage-tracker"].includes(project.slug);
const contents = [
  ...(leadMedia ? [{ id: "lead-media-heading", label: leadMedia.label }] : []),
  ...(hasOverview ? [{ id: "project-overview", label: "Project overview" }] : []),
  { id: "problem-heading", label: "The problem" },
  ...project.sections.map((section, index) => ({ id: "case-section-" + index, label: section.heading })),
  { id: "evidence-heading", label: "Engineering evidence" },
  { id: "limits-heading", label: "Limitations & remaining work" },
  ...(remainingMedia.length ? [{ id: "media-heading", label: mediaHeading }] : []),
  ...(project.citations.length ? [{ id: "citation-heading", label: "Source material" }] : []),
  { id: "links-heading", label: "Project links" },
];
---

<BaseLayout title={project.title + " | " + profile.displayName} description={project.summary} profile={profile} canonicalPath={"/projects/" + project.slug + "/"}>
  <main class="site-frame case-study-page" id="main-content" tabindex="-1">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/projects/">Projects</a><span aria-hidden="true">/</span><span aria-current="page">{project.shortTitle}</span></nav>
    <article class="case-study">
      <header class="case-study__header">
        <p class="eyebrow">{categoryLabels[project.category]} / Case study</p>
        <h1>{project.title}</h1>
        <p class="case-study__summary">{project.summary}</p>
        <dl class="case-metadata">
          <div><dt>Role</dt><dd>{project.role}</dd></div>
          <div><dt>Technologies</dt><dd>{project.technologies.length ? project.technologies.join(", ") : "No implementation stack is asserted in this case study."}</dd></div>
          <div><dt>People or intended audience</dt><dd>{project.stakeholders.join(", ")}</dd></div>
        </dl>
        <aside class="boundary-note" aria-labelledby="boundary-heading">
          <h2 id="boundary-heading">Current status <span class="status-chip">{project.statusLabel}</span></h2>
          <p>{project.currentStatus}</p><p>{project.publicationBoundary}</p>
        </aside>
      </header>

      {leadMedia && <section class="case-study__lead-media" aria-labelledby="lead-media-heading"><p class="eyebrow">Application recording</p><h2 id="lead-media-heading">Captured trips, classification, and editing</h2><MediaBlock projectSlug={project.slug} media={leadMedia} /></section>}
      {hasOverview && <section id="project-overview" class="case-study__overview-visual" aria-label="Project overview"><ProjectOverview slug={project.slug} /></section>}

      <details class="mobile-contents">
        <summary>In this case study</summary>
        <nav aria-label="Case study contents"><ul>{contents.map((item) => <li><a href={"#" + item.id}>{item.label}</a></li>)}</ul></nav>
      </details>
      <div class="case-study__reading">
        <aside class="contents-rail"><nav aria-label="Case study contents"><p class="eyebrow">In this case study</p><ul>{contents.map((item) => <li><a href={"#" + item.id}>{item.label}</a></li>)}</ul><a class="text-link" href="/#contact">Discuss this project <span aria-hidden="true">↗</span></a></nav></aside>
        <div class="case-study__body">
          <section class="case-section" aria-labelledby="problem-heading"><p class="eyebrow">Overview</p><h2 id="problem-heading">The problem</h2><p>{project.problem}</p></section>
          {project.sections.map((section, index) => <section class="case-section" aria-labelledby={"case-section-" + index}><h2 id={"case-section-" + index}>{section.heading}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}{section.bullets && <ul class="evidence-list">{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}</section>)}
          <section class="case-section case-evidence" aria-labelledby="evidence-heading"><p class="eyebrow">Verification</p><h2 id="evidence-heading">Engineering evidence</h2><ul class="evidence-list">{project.evidence.map((item) => <li>{item}</li>)}</ul></section>
          <section class="case-section case-limits" aria-labelledby="limits-heading"><h2 id="limits-heading">Limitations &amp; remaining work</h2><ul class="evidence-list">{project.limitations.map((limitation) => <li>{limitation}</li>)}</ul></section>
          {remainingMedia.length > 0 && <section class="case-section case-media" aria-labelledby="media-heading">
            <p class="eyebrow">Application walkthroughs</p>
            <h2 id="media-heading">{mediaHeading}</h2>
            {project.slug === "john-howard" ? <>
              {publishedMedia.length > 0 && <div class="media-grid">{publishedMedia.map((slot) => <MediaBlock projectSlug={project.slug} media={slot} />)}</div>}
              {pendingMedia.length > 0 && <details class="pending-recordings"><summary>{pendingMedia.length} {pendingMedia.length === 1 ? "recording" : "recordings"} awaiting publication</summary><div class="media-grid">{pendingMedia.map((slot) => <MediaBlock projectSlug={project.slug} media={slot} />)}</div></details>}
            </> : <><p>Each recording has a caption and written transcript. The case study can also be read without video.</p><div class="media-grid">{remainingMedia.map((slot) => <MediaBlock projectSlug={project.slug} media={slot} />)}</div></>}
          </section>}
          {project.citations.length > 0 && <section class="case-section case-citations" aria-labelledby="citation-heading"><p class="eyebrow">Research reference</p><h2 id="citation-heading">Source material</h2><ul>{project.citations.map((citation) => <li><a href={citation.href}>{citation.title}</a><span>{citation.authors}. {citation.publication} ({citation.year}).</span></li>)}</ul></section>}
          <section class="case-section case-links" aria-labelledby="links-heading"><p class="eyebrow">Explore further</p><h2 id="links-heading">Project links</h2>{project.links.length > 0 ? <ul class="link-list">{project.links.map((link) => <li><a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a></li>)}</ul> : <p class="link-fallback">{project.linkFallback}</p>}<div class="action-row"><a class="button button--primary" href="/#contact">Contact Rory</a><a class="button button--secondary" href="/projects/">All projects</a></div></section>
        </div>
      </div>
    </article>
    <div class="case-study__back"><a href="/#projects">Return to the portfolio</a><a href="#top">Back to top ↑</a></div>
  </main>
</BaseLayout>
