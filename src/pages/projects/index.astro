---
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { compilePublicProfile, compilePublicProjects } from "../../lib/publication-compiler.mjs";

const profile = compilePublicProfile(await getCollection("profile"));
const projects = compilePublicProjects(await getCollection("projects"));
---

<BaseLayout
  title={"Projects | " + profile.displayName}
  description="Selected software projects, with roles, evidence, status, and publication boundaries."
  profile={profile}
  canonicalPath="/projects/"
>
  <main id="main-content" class="site-frame project-index" tabindex="-1">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Projects</span>
    </nav>
    <header class="page-heading">
      <p class="eyebrow">Portfolio / Project index</p>
      <h1>Work, shown with its status and boundaries.</h1>
      <p>
        Each case study explains the problem, my role, technologies, evidence,
        and what is not being claimed.
      </p>
    </header>
    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="project-index__return"><a class="text-link" href="/#projects">Return to the portfolio overview</a></p>
  </main>
</BaseLayout>
