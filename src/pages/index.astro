---
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import EducationCard from "../components/EducationCard.astro";
import ResumeDownloads from "../components/ResumeDownloads.astro";
import SectionHeading from "../components/SectionHeading.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { compilePublicProfile, compilePublicProjects } from "../lib/publication-compiler.mjs";

const profile = compilePublicProfile(await getCollection("profile"));
const projects = compilePublicProjects(await getCollection("projects"));
const featuredProjects = projects.filter((project) => project.featured);
const additionalProjects = projects.filter((project) => !project.featured);
---

<BaseLayout title={profile.displayName + " | Kotlin, C# and Python software developer"} description={profile.introduction} profile={profile} canonicalPath="/">
  <main id="main-content" class="site-frame home-page" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">Software developer / {profile.location}</p>
      <h1 id="hero-title">{profile.displayName}</h1>
      <p class="hero__focus">Software developer.<span class="hero__stack">Kotlin · C# · Python</span></p>
      <p class="hero__intro">{profile.introduction}</p>
      <div class="action-row">
        <a class="button button--secondary" href="#contact">Get in touch</a>
        <a class="button button--primary" href={profile.resumePdfHref} download>Download resume (PDF) <span aria-hidden="true">↓</span></a>
        <a class="button button--secondary" href={profile.resumeHref} download>Download resume (Word) <span aria-hidden="true">↓</span></a>
      </div>
    </section>

    <section id="projects" class="content-section projects-section" aria-labelledby="projects-heading">
      <div class="section-heading-row">
      <SectionHeading id="projects-heading" eyebrow="Selected work" title="Projects in focus." />
        <a class="text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a>
      </div>
      <div class="projects-grid">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
      {additionalProjects.length > 0 && (
        <div class="additional-projects">
          <p class="eyebrow">Research &amp; learning</p>
          <div class="additional-projects__grid">
            {additionalProjects.map((project) => <ProjectCard project={project} compact={true} />)}
          </div>
        </div>
      )}
    </section>

    <section id="about" class="content-section about-section" aria-labelledby="about-heading">
      <SectionHeading id="about-heading" eyebrow="About" title={profile.headline} />
      <div class="about-copy">{profile.about.map((paragraph) => <p>{paragraph}</p>)}</div>
    </section>

    <section id="skills" class="content-section skills-section" aria-labelledby="skills-heading">
      <SectionHeading id="skills-heading" eyebrow="Skills" title="A practical toolkit." intro="Development, testing, and communication skills used across my projects." />
      <div class="skills-grid">
        {profile.skills.map((group) => (
          <article class="skill-group">
            <h3>{group.name}</h3>
            <p>{group.note}</p>
            <ul class="skills-list">{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <div class="background-sections">
      <section id="experience" class="content-section experience-section" aria-labelledby="experience-heading">
        <SectionHeading id="experience-heading" eyebrow="Experience" title="Accuracy. Service. Follow-through." intro="Work and volunteer experience that informs how I build software." />
        <div class="experience-list">
          {profile.experience.map((entry) => (
            <article class="experience-item">
              <p class="eyebrow">{entry.organization} / {entry.location}</p>
              <h3>{entry.role}</h3>
              {entry.dateLabel && <p class="experience-item__dates">{entry.dateLabel}</p>}
              <p>{entry.description}</p>
            </article>
          ))}
        </div>
      </section>
      <section id="education" class="content-section education-section" aria-labelledby="education-heading">
        <SectionHeading id="education-heading" eyebrow="Education" title="A foundation to build on." />
        <EducationCard education={profile.education} />
      </section>
    </div>

    <section id="contact" class="content-section contact-section" aria-labelledby="contact-heading">
      <div class="contact-panel">
        <SectionHeading id="contact-heading" eyebrow="Contact" title="Let's build something useful." intro="For software-development roles, product work, or a project you want to discuss." />
        <ResumeDownloads profile={profile} />
        <div class="contact-panel__details">
          <a href={"mailto:" + profile.email}>{profile.email}</a>
          <a href={profile.phoneHref}>{profile.phoneDisplay}</a>
          <a href={profile.githubUrl}>GitHub / Rory-Hughes <span aria-hidden="true">↗</span></a>
          {profile.linkedinUrl && <a href={profile.linkedinUrl}>LinkedIn <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
