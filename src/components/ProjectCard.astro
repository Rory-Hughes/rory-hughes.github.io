---
import type { ProjectRecord } from "../lib/types";
import DemoVideo from "./DemoVideo.astro";

interface Props {
  project: ProjectRecord;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const preview = project.media.find((slot) => slot.id === "overview" && slot.kind === "video" && slot.availability === "published");
const repository = project.links.find((link) => link.kind === "repository");
const categoryLabels = {
  "client-system": "Client system",
  "mobile-application": "Android application",
  "research-project": "Learning project",
};
---

<article class:list={["project-card", { "project-card--featured": project.featured, "project-card--compact": compact }]}>
  <div class="project-card__body">
  <div class="project-card__topline">
    <p class="eyebrow">{categoryLabels[project.category]}</p>
    <span class="status-chip">{project.statusLabel}</span>
  </div>
  <h3><a href={"/projects/" + project.slug + "/"}>{project.shortTitle}</a></h3>
  {!compact && preview && <figure class:list={["project-card__visual", { "project-card__visual--portrait": project.slug === "mileage-tracker" }]}>
    <DemoVideo assetPath={preview.assetPath!} posterPath={preview.posterPath!} label={preview.altText!} describedBy={"preview-caption-" + project.slug} />
    <figcaption id={"preview-caption-" + project.slug}>{project.slug === "john-howard" ? "Program-authoring demo · synthetic data" : "Android dashboard and trip-review demo"}</figcaption>
  </figure>}
  <p class="project-card__summary">{project.summary}</p>
  {!compact && <><p class="project-card__role"><strong>My role</strong> {project.role}</p><ul class="project-card__accomplishments">{project.accomplishments.map((item) => <li>{item}</li>)}</ul></>}
  {project.technologies.length > 0 && (
    <p class="project-card__stack"><span class="visually-hidden">Technologies: </span>{project.technologies.join(" · ")}</p>
  )}
  {project.technologies.length === 0 && (
    <p class="project-card__note">No implementation stack is asserted here.</p>
  )}
  <a class="text-link project-card__link" href={"/projects/" + project.slug + "/"}>
    Read the case study <span aria-hidden="true">↗</span>
  </a>
  {repository && <a class="text-link project-card__source" href={repository.href}>View source on GitHub <span aria-hidden="true">↗</span></a>}
  </div>
</article>
