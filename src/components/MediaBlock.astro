---
import type { z } from "zod";
import type { projectSchema } from "../lib/content-contract.mjs";
import CodeExcerptCard from "./CodeExcerptCard.astro";
import MediaFigure from "./MediaFigure.astro";

type MediaSlot = z.infer<typeof projectSchema>["media"][number];

interface CodeExcerpt {
  id: string;
  title: string;
  description: string;
  sourcePath: string;
  sourceHref?: string;
  language: "csharp" | "kotlin" | "python";
  previewCode: string;
  highlightedHtml: string;
}

interface Props {
  projectSlug: string;
  media: MediaSlot;
  codeExcerpt?: CodeExcerpt;
  leadCodeLayout?: boolean;
}

const { projectSlug, media, codeExcerpt, leadCodeLayout = false } = Astro.props;
const portraitAssetPaths = new Set([
  "media/mileage-dashboard-trip-review.mp4",
  "media/mileage-trip-records.mp4",
  "media/mileage-manual-tracking.mp4",
  "media/mileage-settings-and-vehicles.mp4",
  "media/mileage-reports-logbook.mp4",
]);
const usesPortraitFrame = Boolean(media.assetPath && portraitAssetPaths.has(media.assetPath));
const recordingLayout = projectSlug === "mileage-tracker" && Boolean(codeExcerpt) && !leadCodeLayout;
const headingId = "media-" + projectSlug + "-" + media.id;
const statusLabel = media.reviewStatus === "withheld"
  ? "Withheld"
  : media.availability === "candidate"
    ? "Under review"
    : "Deferred";
---

{media.availability === "published" && media.assetPath && media.altText && media.caption ? (
  codeExcerpt
    ? recordingLayout
      ? <div class="media-demo media-demo--recording" role="group" aria-labelledby={headingId}>
          <MediaFigure media={media} usesPortraitFrame={usesPortraitFrame} captionId={headingId} />
          <CodeExcerptCard excerpt={codeExcerpt} recordingLayout />
        </div>
      : <div class:list={["media-demo", { "media-demo--lead-code": leadCodeLayout }]}><MediaFigure media={media} usesPortraitFrame={usesPortraitFrame} showCaption={!leadCodeLayout} /><CodeExcerptCard excerpt={codeExcerpt} leadLayout={leadCodeLayout} /></div>
    : <MediaFigure media={media} usesPortraitFrame={usesPortraitFrame} />
) : (
  <article class="media-fallback" aria-labelledby={headingId}>
    <div class="media-fallback__topline">
      <p class="eyebrow">Evidence status</p>
      <span class="status-chip status-chip--quiet">{statusLabel}</span>
    </div>
    <h3 id={headingId}>{media.label}</h3>
    <p>{media.fallbackText}</p>
    <p class="media-fallback__note">The written case study remains available without media.</p>
  </article>
)}
