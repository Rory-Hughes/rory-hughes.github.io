---
import type { PublicProfile } from "../lib/types";

interface Props {
  profile: PublicProfile;
}

const { profile } = Astro.props;
const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: "/skills/", label: "Skills" },
  { href: "/experience/", label: "Experience" },
  { href: "/education/", label: "Education" },
  { href: "/contact/", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">RH</span>
      <span>{profile.displayName}</span>
    </a>

    <div class="site-header__actions">
      <nav class="desktop-nav" aria-label="Primary navigation">
        {links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>)}
      </nav>

      <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" data-theme-toggle>
        <span class="theme-toggle__icon" aria-hidden="true" data-theme-toggle-icon>☾</span>
      </button>

      <details class="mobile-menu" data-mobile-menu>
        <summary>
          <span class="visually-hidden">Menu</span>
          <span class="mobile-menu__icon" aria-hidden="true">☰</span>
        </summary>
        <nav aria-label="Mobile primary navigation">
          {links.map((link) => <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>{link.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>("[data-mobile-menu]");
  for (const menu of menus) {
    for (const link of menu.querySelectorAll("a")) {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    }
  }

  const root = document.documentElement;
  const themeButtons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  const themeMedia = window.matchMedia("(prefers-color-scheme: dark)");
  const themeStorageKey = "rory-hughes-theme";
  let hasSavedTheme = false;

  try {
    const storedTheme = window.localStorage.getItem(themeStorageKey);
    hasSavedTheme = storedTheme === "light" || storedTheme === "dark";
  } catch {
    // Theme switching still works for this page if browser storage is unavailable.
  }

  const updateThemeControls = () => {
    const darkThemeEnabled = root.dataset.theme === "dark";
    for (const button of themeButtons) {
      button.setAttribute("aria-pressed", String(darkThemeEnabled));
      button.setAttribute("aria-label", darkThemeEnabled ? "Switch to light mode" : "Switch to dark mode");
      const icon = button.querySelector<HTMLElement>("[data-theme-toggle-icon]");
      if (icon) icon.textContent = darkThemeEnabled ? "☀" : "☾";
    }
  };

  const applyTheme = (theme: "light" | "dark", savePreference = false) => {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#0f1724" : "#f7f8fc");
    if (savePreference) {
      try {
        window.localStorage.setItem(themeStorageKey, theme);
        hasSavedTheme = true;
      } catch {
        // Keep the selected theme for this page when persistence is unavailable.
      }
    }
    updateThemeControls();
  };

  updateThemeControls();
  for (const button of themeButtons) {
    button.addEventListener("click", () => {
      applyTheme(root.dataset.theme === "dark" ? "light" : "dark", true);
    });
  }

  themeMedia.addEventListener("change", (event) => {
    if (!hasSavedTheme) applyTheme(event.matches ? "dark" : "light");
  });
</script>
